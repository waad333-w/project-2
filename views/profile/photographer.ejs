<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= photographer.username %> Profile | LENS</title>
</head>
<body>
    <%- include("../partials/navbar") %>

    <main class="page">

    <div class="profile">


    <% if(photographer.profilePic){ %>

        <img
        src="<%= photographer.profilePic %>"
        alt="Profile Picture"
        class="profile-image"
        >
    <% } %>


    <h1><%= photographer.username %></h1>

    <p>
        <strong>Account Type:</strong>
        <%= photographer.role %>
    </p>

    <p>
        <strong>Bio:</strong>
        <%= photographer.bio || "No bio yet." %>
    </p>

    <p>
        <strong>Photography Style:</strong>
        <%= photographer.style || "No style added yet." %>
    </p>

    <% if(user && user.role === "user"){ %>

    <a 
    href="/bookings/new/<%= photographer._id %>" class="button">
    Book photographer
    </a>

    <% } %>

    </div>

    <br>


    <h1 class="page-title">Portfolio</h1>

    <% if(posts.length === 0){%>

        <div class="empty">

        <h2>
            No posts yet.
        </h2>

        <p>
            This photographer has not added any 
            photography posts yet.
        </p>

        </div>

    <% } else { %>
   

    <% posts.forEach((post)=>{ %>

        <div class="post">

            <img 
            src="<%= post.image %>"
            alt="Photography"
            class="post-image"
            >

            <p>
                <%= post.caption %>
            </p>

        
        </div>

        
    <% }) %>
    <% } %>

    </main>
</body>
</html>