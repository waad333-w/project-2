<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photographer Profile</title>
</head>
<body>
    <%- include("../partials/navbar") %>

    <h1>Photographer Profile</h1>

    <% if(photographer.profilePic){ %>

        <img
        src="<%= photographer.profilePic %>"
        alt="Profile Picture"
        width="150"
        >
    <% } %>


    <h2><%= photographer.username %></h2>

    <p>
        <strong>Account Type:</strong>
        <%= photographer.role %>
    </p>

    <p>
        <strong>Bio:</strong>
        <%= photographer.bio || "No bio yet." %>
    </p>

    <p>
        <strong>Photography Style:</strong>
        <%= photographer.style || "No style added yet." %>
    </p>

    <h2>Portfolio</h2>

    <% if(posts.length === 0){%>

        <p>
            No posts yet.
        </p>
    <% } %>

    <% posts.forEach((post)=>{ %>

        <div>

            <img 
            src="<%= post.image %>"
            alt="Photography"
            width="300"
            >

            <p>
                <%= post.caption %>
            </p>

        <% if(user && user._id.toString() === photographer._id.toString()){ %>

            <a href="/posts/<%= post._id %>/edit">
                Edit
            </a>


            <form action="/posts/<%= post._id %>?_method=DELETE"method="POST">
        
                <button type="submit">
                    Delete
                </button>
        </form>

        <% } %>
        </div>

        <hr>
    <% }) %>

</body>
</html>