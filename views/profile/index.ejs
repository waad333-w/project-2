<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | LENS</title>
</head>
<body>
    <%- include("../partials/navbar") %>

    <main class="page">
        
    <div class="profile">


    <% if(profileUser.profilePic){ %>

        <img
        src="<%= profileUser.profilePic %>"
        alt="Profile Picture"
        class="profile-image"
        >
    <% } %>


    <h1><%= profileUser.username %></h1>

    <p>
        <strong>Account Type:</strong>
        <%= profileUser.role %>
    </p>

    <p>
        <strong>Bio:</strong>
        <%= profileUser.bio || "No bio yet." %>
    </p>

    <% if(profileUser.role === "photographer"){%>

    <p>
        <strong>Photography Style:</strong>
        <%= profileUser.style || "No style added yet." %>
    </p>

    <% } %>

           <a href="/profile/edit" class="button">
            Edit Profile
           </a>
        

    </div>
    </main>


</body>
</html>