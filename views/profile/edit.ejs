<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile | LENS</title>
</head>

<body>
    <%- include("../partials/navbar") %>

    <main class="page">


        <form
         action="/profile?_method=PUT"
         method="POST"
         class="form"
         enctype="multipart/form-data"
         >

            <h1>Edit Profile</h1>

           

            <label for="profilePic">
                Profile Picture
            </label>

            <input
             type="file"
             name="profilePic"
             id="profilePic"
             accept="image/*"
             >


            <label for="bio">
                Bio
            </label>

            

            <textarea name="bio" id="bio"><%= profileUser.bio %></textarea>


            <% if(profileUser.role==="photographer" ){ %>

                <label for="style">
                    Photography Style
                </label>

                <input type="text" name="style" id="style" value="<%= profileUser.style %>">


                <% } %>

                    <button type="submit" class="button">
                        Save Profile
                    </button>

                    <a href="/profile" class="button-outline">
                        Cancel
                    </a>
        </form>

        </main>




</body>

</html>