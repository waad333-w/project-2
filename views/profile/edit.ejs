<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
</head>

<body>
    <%- include("../partials/navbar") %>

        <h1>Edit Profile</h1>


        <form action="/profile?_method=PUT" method="POST">

            <label for="profilePic">
                Profile Picture URL:
            </label>

            <input type="text" name="profilePic" id="profilePic" value="<%= profileUser.profilePic %>">

            <br><br>

            <label for="bio">
                Bio:
            </label>

            <br>

            <textarea name="bio" id="bio" rows="2" cols="40"><%= profileUser.bio %></textarea>

            <br><br>

            <% if(profileUser.role==="photographer" ){ %>

                <label for="style">
                    Photography Style:
                </label>

                <input type="text" name="style" id="style" value="<%= profileUser.style %>">

                <br><br>

                <% } %>

                    <button type="submit">
                        Save Profile
                    </button>
        </form>


        <br>


        <form action="/profile" method="GET">

            <button type="submit">
                Cancel
            </button>
        </form>

</body>

</html>