<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Requests | LENS</title>
    <link rel="icon" type="image/png" href="/images/LENS.png">

</head>
<body>
    <%- include("../partials/navbar") %>

    <main class="page">

    <h1 class="page-title">Booking Requests</h1>

    <p class="page-text">
        Manage booking requests from users.
    </p>

    <% if(bookings.length === 0){ %>

        <div class="empty">

        <h2>
            No booking requests
        </h2>

        <p>
            New booking requests will appear here.
        </p>

        </div>

        <% } %>

    <% bookings.forEach((booking)=>{ %>

        <div class="booking">

            <h2>
                Request from:
                <%= booking.user.username %>
            </h2>

            <p>
                <strong>Date:</strong>
                <%= booking.date.toDateString() %>
            </p>

            <p>
                <strong>Message:</strong>
                <%= booking.message || "No message." %>
            </p>

            <p>
                <strong>Status:</strong>
            

             <span class="status <%= booking.status.toLowerCase() %>">
                    <%= booking.status %>
                </span>
            </p>


            <% if(booking.status === "Pending"){ %>

                <div class="buttons">

                <form action="/bookings/<%= booking._id %>/accept?_method=PUT" method="POST">

                    <button type="submit" class="button">
                        Accept
                    </button>
                </form>

                <form action="/bookings/<%= booking._id %>/reject?_method=PUT" method="POST">

                    <button type="submit" class="button button-outline">
                        Reject
                    </button>
                </form>
                </div>
                <% } %>
        </div>

        <% }) %>
    </main>

</body>
</html>