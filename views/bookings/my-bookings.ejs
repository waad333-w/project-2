<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings | LENS</title>
    <link rel="icon" type="image/png" href="/images/LENS.png">

</head>
<body>
    <%- include("../partials/navbar") %>

    <main class="page">

    <h1 class="page-title">My Bookings</h1>
    <p class="page-text">
        View the photographers you have requested to book.
    </p>

    <% if(bookings.length === 0){ %>

        <div class="empty">

        <h2>
            No bookings yet
        </h2>

        <p>
            Explore photographers and send your first
            booking request.
        </p>

        </div>

        <% } %>

        <% bookings.forEach((booking)=>{ %>

            <div class="booking">

                <h2>
                    Photographer:
                    <%= booking.photographer.username %>
                </h2>


                <p>
                    <strong>Date:</strong>
                    <%= booking.date.toDateString() %>
                </p>

                <p>
                    <strong>Message:</strong>
                    <%= booking.message || "No message." %>
                </p>


                <p>
                    <strong>Status:</strong>

                    <span class="status <%= booking.status.toLowerCase() %>">
                    <%= booking.status %>
                </span>
                </p>
                

            </div>

            <% }) %>

    </main>

</body>
</html>