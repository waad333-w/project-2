<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post | LENS</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="page">



    <form
     action="/posts/<%= post._id %>?_method=PUT"
     method="POST"
     class="form"
     enctype="multipart/form-data"
     >

        <h1>Edit Post</h1>

        <label for="image">
            Change Photo:
        </label>

        <input
        type="file"
        name="image"
        id="image"
       ]accept="image/*"
        >


        <label for="caption">
            Caption:
        </label>

        <textarea
        name="caption"
        id="caption"
        ><%= post.caption %></textarea>


        <button type="submit" class="button">
            Update Post
        </button>
    </form>
    </main>
</body>
</html>