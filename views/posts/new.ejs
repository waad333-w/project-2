<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Post | LENS</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="page">


    <form 
     action="/posts"
     method="POST"
     class="form"
     enctype="multipart/form-data"
     >

        <h1>Create New Post</h1>


        <label for="image">
            Image URL:
        </label>

        <input
        type="file"
        name="image"
        id="image"
        accept="/image/*"
        required
        >


        <label for="caption">
            Caption:
        </label>

        <textarea
        name="caption"
        id="caption"
        ></textarea>

        <button type="submit" class="button">
            Create Post
        </button>


    </form>

    </main>

</body>
</html>