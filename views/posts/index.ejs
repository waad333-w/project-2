<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>My Portfolio</h1>

    <form action="/posts/new" method="GET">
        <button type="submit">
            Create New Post 
        </button>
    </form>

    <br>

    <% if(posts.length === 0){ %>
        <p>You have no posts yet.</p>
        <% } %>

    <% posts.forEach((post)=>{ %>

        <div>

            <img
            src="<%= post.image %>"
            alt="Photography"
            width="300"
            >
            <p>
                <%= post.caption %>
            </p>

            <form action="/posts/<%= post._id %>/edit" method="GET">

                <button type="submit">
                    Edit Post
                </button>
            </form>

            <form action="/posts/<%= post._id %>?_method=DELETE" method="POST">

                <button type="submit">
                    Delete
                </button>
            </form>
        </div>
        <hr>
        <% }) %>
</body>
</html>