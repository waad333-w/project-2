<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio | LENS</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="page">

        <h1 class="page-title">
            My Portfolio
        </h1>
    <p class="page-text">
        Manage the photography you share with users.
    </p>

    <a href="/posts/new" class="button">
        Create New Post 
    </a>

    <br>
    <br>

    <% if(posts.length === 0){ %>

        <div class="empty">

            <h2>No posts yet</h2>
            <p>Create your first photography post.</p>
        </div>
        <% } %>

    <% posts.forEach((post)=>{ %>

        <div class="post">

            <img
            src="<%= post.image %>"
            alt="Photography"
            class="post-image"
            >

            <p>
                <%= post.caption %>
            </p>

            <div class="buttons">
            <a href="/posts/<%= post._id %>/edit" class="button button-outline">
                Edit Post
            </a>

            <form action="/posts/<%= post._id %>?_method=DELETE" method="POST">

                <button type="submit" class="button">
                    Delete
                </button>
            </form>
        </div>
        </div>
        <% }) %>
    </main>
</body>
</html>