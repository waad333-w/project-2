<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photographers</title>
</head>
<body>
    <%- include("../partials/navbar") %>

    <h1>Photographers</h1>
    <% photographers.forEach((photographer)=>{ %>

        <div>
            <% if(photographer.profilePic){ %>

                <img
                src="<%= photographer.profilePic %>"
                alt="Profile Picture"
                width="100"
                >
            <% } %>

    <h2><%= photographer.username %></h2>

    <p>
        <%= photographer.style || "Photography style not added yet." %>
    </p>

    <p>
        <%= photographer.bio || "No bio yet." %>
    </p>

        <form action="/profile/<%= photographer._id %>" method="GET">

                <button type="submit">
                    View Profile
                </button>
            </form>

        </div>

        <hr>

    <% }) %>

</body>
</html>